aside class="w-60 shrink-0 bg-sidebar border-r border-line flex flex-col"
  / Logo
  div class="px-5 py-4"
    = image_tag "logo.svg", alt: t("auth.brand"), class: "h-10 w-auto"

  / Upload button (placeholder — real dropzone lands in Step 5)
  div class="px-3 pb-4"
    button type="button" class="flex w-full items-center justify-center gap-2 h-9 px-4 rounded-control bg-primary hover:bg-primary-hover text-white text-sm font-medium"
      svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0"
        path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"
      = t("library.sidebar.upload")

  / Primary navigation — All files (active) + Shared with me
  nav class="px-2 space-y-1"
    = link_to root_path, class: "flex items-center gap-3 h-9 px-3 rounded-control text-sm #{sidebar_nav_link_classes(root_path)}" do
      svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0"
        path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44z"
      span = t("library.sidebar.all_files")
    = link_to shared_with_me_path, class: "flex items-center gap-3 h-9 px-3 rounded-control text-sm #{sidebar_nav_link_classes(shared_with_me_path)}" do
      svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0"
        path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0z"
      span = t("library.sidebar.shared_with_me")
