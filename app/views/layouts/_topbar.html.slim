header class="h-14 shrink-0 bg-surface border-b border-line flex items-center gap-4 px-8"
  / Search (placeholder — real search lands in the next part of Step 4)
  div class="relative w-full max-w-md"
    span class="absolute inset-y-0 left-0 flex items-center pl-3 text-ink-muted"
      svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true"
        path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607z"
    input type="search" placeholder=t("library.topbar.search") aria-label=t("library.topbar.search") class="w-full h-9 pl-9 pr-3 bg-canvas rounded-control text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:bg-white focus:ring-2 focus:ring-primary-soft"

  div class="ml-auto relative" data-controller="dropdown"
    button type="button" data-action="dropdown#toggle" data-dropdown-target="button" aria-haspopup="true" aria-expanded="false" aria-label=t("library.topbar.account_menu") class="flex items-center gap-2 rounded-control p-1 hover:bg-canvas focus:outline-none focus:ring-2 focus:ring-primary-soft"
      span class="h-9 w-9 rounded-full bg-primary-soft text-primary text-sm font-semibold flex items-center justify-center" = current_user.name[0].upcase
      svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0 text-ink-muted" aria-hidden="true"
        path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"

    div data-dropdown-target="menu" role="menu" class="hidden absolute right-0 mt-2 w-56 bg-surface border border-line rounded-card shadow-pop py-1 z-20"
      div class="px-3 py-2 border-b border-line"
        p class="text-sm font-medium text-ink truncate" = current_user.name
        p class="text-[13px] text-ink-muted truncate" = current_user.email
      = button_to destroy_user_session_path, method: :delete, form_class: "block", class: "flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-ink hover:bg-canvas focus:outline-none focus:bg-canvas" do
        svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0 text-ink-muted" aria-hidden="true"
          path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"
        span = t("library.topbar.sign_out")
