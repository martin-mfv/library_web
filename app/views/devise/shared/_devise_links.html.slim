- if controller_name == "registrations"
  p class="text-sm text-ink-muted"
    = t("auth.links.already_have_account")
    = " "
    = link_to t("auth.links.sign_in"), new_session_path(resource_name), class: "text-primary hover:underline"

- if devise_mapping.registerable? && controller_name == "sessions"
  p class="text-sm text-ink-muted"
    = t("auth.links.dont_have_account")
    = " "
    = link_to t("auth.links.sign_up"), new_registration_path(resource_name), class: "text-primary hover:underline"

- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations"
  = link_to t("auth.links.forgot_password"), new_password_path(resource_name), class: "text-sm text-primary hover:underline"
