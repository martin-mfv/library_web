- content_for :title, "Reset password · Library"

section class="w-full max-w-md bg-white border border-line rounded-card shadow-card p-8"
  div class="text-center mb-6"
    span class="text-base font-semibold text-ink" Library
    h1 class="text-2xl font-semibold text-ink mt-2" Reset password
    p class="text-sm text-ink-muted mt-1" Enter your new password.

  = render "devise/shared/flash"

  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f|
    = f.hidden_field :reset_password_token

    - if resource.errors.any?
      div class="rounded-control border border-danger/30 bg-[#FDECEA] px-3 py-2 text-sm text-danger"
        = resource.errors.full_messages.to_sentence

    div
      = f.label :password, "New password", class: "block text-[13px] font-medium text-ink mb-1.5"
      = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full h-10 px-3 rounded-control border border-line bg-white text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-soft"

    div
      = f.label :password_confirmation, "Confirm password", class: "block text-[13px] font-medium text-ink mb-1.5"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full h-10 px-3 rounded-control border border-line bg-white text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-soft"

    = f.submit "Update password", class: "inline-flex items-center justify-center w-full h-9 px-4 rounded-control text-sm font-medium bg-primary hover:bg-primary-hover text-white focus:outline-none focus:ring-2 focus:ring-primary-soft"

  div class="mt-4 flex flex-col gap-2 text-center"
    = render "devise/shared/links"
