- content_for :title, t("auth.passwords.edit.title", brand: t("auth.brand"))

section class="w-full max-w-md bg-white border border-line rounded-card shadow-card p-8"
  div class="text-center mb-6"
    = image_tag "logo.svg", alt: t("auth.brand"), class: "block h-14 md:h-16 w-auto mx-auto"
    h1 class="text-2xl font-semibold text-ink mt-2" = t("auth.passwords.edit.heading")
    p class="text-sm text-ink-muted mt-1" = t("auth.passwords.edit.subtitle", brand: t("auth.brand"))

  = render "devise/shared/devise_flash"

  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f|
    = f.hidden_field :reset_password_token

    div
      = f.label :password, t("auth.passwords.edit.new_password_label"), class: "block text-[13px] font-medium text-ink mb-1.5"
      = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full h-10 px-3 rounded-control border border-line bg-white text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-soft"

    div
      = f.label :password_confirmation, t("auth.passwords.edit.confirm_password_label"), class: "block text-[13px] font-medium text-ink mb-1.5"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full h-10 px-3 rounded-control border border-line bg-white text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-soft"

    = f.submit t("auth.passwords.edit.submit"), class: "inline-flex items-center justify-center w-full h-9 px-4 rounded-control text-sm font-medium bg-primary hover:bg-primary-hover text-white focus:outline-none focus:ring-2 focus:ring-primary-soft"

  div class="mt-4 flex flex-col gap-2 text-center"
    = render "devise/shared/devise_links"
