- if current_page.last?
  span class="inline-flex items-center justify-center min-w-16 h-9 px-3 rounded-control text-sm text-ink-muted border border-line opacity-50 cursor-not-allowed" aria-disabled="true" = t("kaminari.pagination.next")
- else
  = link_to url, rel: "next", remote: remote, class: "inline-flex items-center justify-center min-w-16 h-9 px-3 rounded-control text-sm text-ink border border-line hover:bg-canvas focus:outline-none focus:ring-2 focus:ring-primary-soft" do
    = t("kaminari.pagination.next")
