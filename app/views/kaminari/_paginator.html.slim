= paginator.render do
  - if total_pages > 1
    nav class="flex items-center justify-end gap-1.5 border-t border-line px-4 py-3" role="navigation" aria-label="Pagination"
      == prev_page_tag
      - each_page do |page|
        - if page.display_tag?
          == page_tag page
        - elsif !page.was_truncated?
          == gap_tag
      == next_page_tag
