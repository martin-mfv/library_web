tr class="group h-12 border-b border-line last:border-b-0 hover:bg-primary-soft"
  td class="px-4 w-[42%]"
    div class="flex items-center gap-3 min-w-0"
      span class="text-ink-muted shrink-0"
        svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true"
          path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9z"
      span class="text-sm font-medium text-ink truncate max-w-full" = file.name
      - if file.visibility_private?
        span class="inline-flex items-center gap-1 text-xs font-medium text-warning bg-[#FFF6E6] px-2 py-0.5 rounded-full shrink-0"
          svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"
            path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25z"
          | Private
  td class="px-4 text-[13px] text-ink-muted whitespace-nowrap" = file.uploaded_at.strftime("%b %-d, %Y")
  td class="px-4 text-[13px] text-ink-muted whitespace-nowrap" = number_to_human_size(file.byte_size)
  td class="px-4 text-[13px] text-ink-muted whitespace-nowrap w-[22%]"
    - if file.authored_by?(current_user)
      span class="inline-flex items-center gap-1 text-xs font-medium text-primary bg-primary-soft px-2 py-0.5 rounded-full shrink-0" = t("library.owner.me")
    - else
      span class="inline-flex max-w-45 items-center gap-1 truncate text-xs font-medium text-ink-muted bg-[#F5F5F5] px-2 py-0.5 rounded-full shrink-0" = file.user.name
  td class="px-4 text-right"
    div class="relative inline-block" data-controller="dropdown"
      button type="button" data-action="dropdown#toggle" data-dropdown-target="button" aria-haspopup="true" aria-expanded="false" aria-label="File actions" class="text-ink-muted rounded-control p-1 hover:bg-canvas focus:outline-none focus:ring-2 focus:ring-primary-soft"
        svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true"
          path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0z"
      div data-dropdown-target="menu" data-action="click->dropdown#hide" role="menu" class="hidden absolute top-full right-0 mt-2 w-56 bg-white border border-line rounded-card shadow-pop py-1 z-30"
        = link_to "Download", rails_blob_path(file.attachment, disposition: "attachment"), class: "flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-ink hover:bg-canvas focus:outline-none focus:bg-canvas"
        = button_to "Copy", copy_library_file_path(file), method: :post, form_class: "block", class: "flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-ink hover:bg-canvas focus:outline-none focus:bg-canvas"
        - if file.authored_by?(current_user)
          - visibility_action_label = file.visibility_public? ? "Make Private" : "Publish"
          = button_to visibility_action_label, change_visibility_library_file_path(file), method: :patch, form_class: "block", class: "flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-ink hover:bg-canvas focus:outline-none focus:bg-canvas"
          = button_to "Remove", library_file_path(file), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this file?" }, form_class: "block", class: "flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-danger hover:bg-canvas focus:outline-none focus:bg-canvas"
