- content_for :title, "#{t("library.#{action_name}.title")} · #{t('auth.brand')}"

- content_for :topbar_search do
  = form_with url: @search.url, method: @search.method, class: "relative w-full max-w-md" do |f|
    span class="absolute inset-y-0 left-0 flex items-center pl-3 text-ink-muted"
      svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true"
        path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607z"
    = f.search_field :q, value: @search.q, placeholder: t("library.topbar.search"), class: "w-full h-9 pl-9 pr-3 bg-canvas rounded-control text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:bg-white focus:ring-2 focus:ring-primary-soft"

div class="max-w-5xl mx-auto space-y-6"
  header class="flex items-end justify-between gap-4"
    div
      h1 class="text-2xl font-semibold text-ink" = t("library.#{action_name}.title")
      p class="text-[13px] text-ink-muted mt-1" = t("library.index.count", count: @files.total_count)

  div class="bg-surface border border-line rounded-card shadow-card overflow-hidden"
    table class="w-full text-left"
      thead
        tr class="border-b border-line"
          = render "sort_header", column: "name", label: t("library.index.columns.name"), search: @search
          = render "sort_header", column: "date", label: t("library.index.columns.modified"), search: @search
          = render "sort_header", column: "size", label: t("library.index.columns.size"), search: @search
          th scope="col" class="px-4 py-2 text-xs font-semibold uppercase tracking-wide text-ink-muted whitespace-nowrap" = t("library.index.columns.owner")
          th scope="col" class="w-12 px-4 py-2"
            span class="sr-only" = t("library.index.columns.actions")
      tbody
        - if @files.any?
          = render partial: "file_row", collection: @files, as: :file
        - else
          tr
            td colspan="5" class="px-4 py-16 text-center"
              p class="text-sm font-medium text-ink" = t("library.#{action_name}.empty.title")

    = paginate @files
